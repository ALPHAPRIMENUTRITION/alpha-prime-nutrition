# =============================================================
# ALPHA PRIME NUTRITION · Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local a git.
# =============================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública "anon" (o "publishable"). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role" (o "secret"). SOLO servidor: salta RLS. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ---
# URL pública del sitio (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Fase 6, opcional por ahora) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_ONE_TIME=price_...

# --- Datos demo (solo para npm run seed) ---
# Contraseña que tendrán todas las cuentas demo
DEMO_PASSWORD=AlphaDemo2026!
